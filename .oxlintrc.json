{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@dugout/*"], "message": "core must not import other packages" }
        ] }]
      }
    },
    {
      "files": ["packages/web/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@dugout/server", "@dugout/cli"], "message": "web talks to server over HTTP only" }
        ] }]
      }
    },
    {
      "files": ["packages/server/**", "packages/cli/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@dugout/web"], "message": "no imports across packages except @dugout/core" }
        ] }]
      }
    }
  ]
}
