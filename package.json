{
  "name": "dugout",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc -b && pnpm --filter @dugout/web typecheck",
    "test": "vitest run",
    "build": "tsc -b && pnpm --filter @dugout/web build",
    "serve": "node packages/server/dist/bin.js",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "Hand coding tasks to Codex and Claude, verify, cross-review, and watch what happened.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulkadiripek/dugout.git"
  },
  "homepage": "https://github.com/abdulkadiripek/dugout"
}
